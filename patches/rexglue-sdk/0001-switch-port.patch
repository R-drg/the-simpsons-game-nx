+        ".Lrex_exc_dump:\n"
+        "    adrp x6, g_rex_exc_ocupadas\n"
+        "    add  x6, x6, :lo12:g_rex_exc_ocupadas\n"
+        "    mov  w7, wzr\n"
+        ".Lrex_exc_pide:\n"
