diff --git a/thirdparty/ffmpeg-overlay/config_switch_aarch64.h b/thirdparty/ffmpeg-overlay/config_switch_aarch64.h
index c2a507cc..fe99aaea 100644
--- a/thirdparty/ffmpeg-overlay/config_switch_aarch64.h
+++ b/thirdparty/ffmpeg-overlay/config_switch_aarch64.h
@@ -14,3 +14,22 @@
 #define HAVE_MMAP 0
 #undef HAVE_SYSCONF
 #define HAVE_SYSCONF 0
+
+/* The game's cutscenes are EA VP6 movies. On the Switch the game's own VP6
+ * decoder, recompiled, cannot keep up with them, so the port decodes them with
+ * FFmpeg's (see movie_decoder.cpp in the port). These are the decoder and the
+ * DSP code configure selects for it (vp6_decoder_select). */
+#undef CONFIG_VP6_DECODER
+#define CONFIG_VP6_DECODER 1
+#undef CONFIG_H264CHROMA
+#define CONFIG_H264CHROMA 1
+#undef CONFIG_HPELDSP
+#define CONFIG_HPELDSP 1
+#undef CONFIG_HUFFMAN
+#define CONFIG_HUFFMAN 1
+#undef CONFIG_VIDEODSP
+#define CONFIG_VIDEODSP 1
+#undef CONFIG_VP3DSP
+#define CONFIG_VP3DSP 1
+#undef CONFIG_VP56DSP
+#define CONFIG_VP56DSP 1
