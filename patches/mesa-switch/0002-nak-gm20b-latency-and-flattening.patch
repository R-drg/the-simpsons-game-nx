diff --git a/src/nouveau/compiler/nak/opt_instr_sched_common.rs b/src/nouveau/compiler/nak/opt_instr_sched_common.rs
index 2d8be486f6d..ae3e1241647 100644
--- a/src/nouveau/compiler/nak/opt_instr_sched_common.rs
+++ b/src/nouveau/compiler/nak/opt_instr_sched_common.rs
@@ -289,7 +289,15 @@ pub fn estimate_variable_latency(sm: &ShaderModelInfo, op: &Op) -> u32 {
         | Op::Tld4(_)
         | Op::Tmml(_)
         | Op::Txd(_)
-        | Op::Txq(_) => 32,
+        | Op::Txq(_) => {
+            // Tegra X1 (GM20B) shares LPDDR4 with the CPU: a texture miss
+            // costs hundreds of cycles, not 32. A larger estimate makes the
+            // pre-pass separate each fetch from its first use and keep more
+            // in flight. Only scheduling priority changes; the dependency
+            // barriers come from calc_instr_deps. From nfsmw-nx's Mesa patch
+            // (MIT).
+            if sm.sm() < 70 { 200 } else { 32 }
+        }
 
         // Surface ops
         Op::SuLd(_)
@@ -314,7 +322,11 @@ pub fn estimate_variable_latency(sm: &ShaderModelInfo, op: &Op) -> u32 {
         | Op::Ipa(_)
         | Op::CCtl(_)
         | Op::LdTram(_)
-        | Op::MemBar(_) => 32,
+        | Op::MemBar(_) => {
+            // Global loads from the shared LPDDR4 likewise take far longer
+            // than 32 cycles on GM20B (see the texture ops above).
+            if sm.sm() < 70 { 200 } else { 32 }
+        }
 
         // Control-flow ops
         Op::WarpSync(_) => 16,
diff --git a/src/nouveau/compiler/nak_nir.c b/src/nouveau/compiler/nak_nir.c
index beb01b1d9db..b23fee112bb 100644
--- a/src/nouveau/compiler/nak_nir.c
