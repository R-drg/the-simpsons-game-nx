@@ -203,8 +203,14 @@ nak_optimize_nir(nir_shader *nir, const struct nak_compiler *nak)
       LOOP_OPT(nir, nir_opt_dce);
       LOOP_OPT(nir, nir_opt_cse);
 
+      /* Before Volta NAK has no if-to-predicate pass, so every if that
+       * survives NIR is a real SSY/BRA/SYNC. Flatten small ones as ANV and
+       * RADV do (limit 8). From nfsmw-nx's Mesa patch (MIT); watch
+       * NVK_SHADER_STATS for local-memory spills if this ever raises register
+       * pressure too far.
+       */
       nir_opt_peephole_select_options peephole_select_options = {
-         .limit = 0,
+         .limit = nak->sm < 70 ? 8 : 0,
          .discard_ok = true,
       };
       LOOP_OPT_NOT_IDEMPOTENT(nir, nir_opt_peephole_select,
