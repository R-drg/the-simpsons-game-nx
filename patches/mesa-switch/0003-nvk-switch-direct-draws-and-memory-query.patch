+#ifdef HAVE_SWITCH_PLATFORM
+/* A draw that can be issued without the draw macro: the parameters it would
+ * write are all zero and already are, and there is no multiview loop.  The
+ * nouveau GL driver issues direct draws on these GPUs the same way.
+ */
+static bool
+nvk_switch_direct_draw_ok(struct nvk_cmd_buffer *cmd, uint32_t instance_count,
+                          int32_t first_vertex_or_offset, uint32_t first_instance)
+{
+   return nvk_cmd_buffer_3d_cls(cmd) < PASCAL_B &&
+          instance_count == 1 && first_vertex_or_offset == 0 &&
+          first_instance == 0 &&
+          cmd->state.gfx.render.view_mask == 0 &&
+          cmd->state.gfx.switch_draw_params_zero;
+}
+
+static uint32_t
+nvk_switch_direct_begin(void)
+{
+   uint32_t begin;
+   V_NVC197_BEGIN(begin, {
+      .primitive_id = PRIMITIVE_ID_FIRST,
+      .instance_id = INSTANCE_ID_FIRST,
+      .split_mode = SPLIT_MODE_NORMAL_BEGIN_NORMAL_END,
+      .instance_iterate_enable = false,
+   });
+   return begin;
+}
+#endif
+
