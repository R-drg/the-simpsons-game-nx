+      struct nv_push *p = nvk_cmd_buffer_push(cmd, 7);
+      P_MTHD(p, NV9097, BEGIN);
+      P_INLINE_DATA(p, nvk_switch_direct_begin());
+      P_MTHD(p, NV9097, SET_VERTEX_ARRAY_START);
+      P_NV9097_SET_VERTEX_ARRAY_START(p, 0);
+      P_NV9097_DRAW_VERTEX_ARRAY(p, vertexCount);
+      P_MTHD(p, NV9097, END);
+      P_INLINE_DATA(p, 0);
+      return;
+   }
+#endif
+
    struct nv_push *p = nvk_cmd_buffer_push(cmd, 6);
    P_1INC(p, NV9097, CALL_MME_MACRO(NVK_MME_DRAW));
    P_INLINE_DATA(p, 0 /* draw_index */);
@@ -4991,6 +5039,10 @@ nvk_CmdDraw(VkCommandBuffer commandBuffer,
    P_INLINE_DATA(p, instanceCount);
